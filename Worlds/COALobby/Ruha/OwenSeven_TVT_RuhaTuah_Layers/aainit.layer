SCR_AIWorld : "{65DEC16960498027}Prefabs/AI/SCR_AIWorld_Ruha.et" {
 coords 5105.184 53.5 4764.668
}
CRF_Gamemode CRF_Lobby1 : "{6A996BBFCEB37E78}Prefabs/MP/Modes/Lobby/CRF_Lobby.et" {
 coords 5227.131 58.188 3819.151
 userScript "	int stage = 0;"\
 "	"\
 "	void deleteFlags()"\
 "	{"\
 "		IEntity flag = GetGame().GetWorld().FindEntityByName(\"HorseTrackTP\");"\
 "		SCR_EntityHelper.DeleteEntityAndChildren(flag);"\
 "		"\
 "		flag = GetGame().GetWorld().FindEntityByName(\"LavaTP\");"\
 "		SCR_EntityHelper.DeleteEntityAndChildren(flag);"\
 ""\
 "	}"\
 ""\
 "	override void EOnFrame(IEntity owner, float timeSlice)"\
 "	{"\
 "		if (stage > 1)"\
 "			return;"\
 "		"\
 "		bool safeStart = CRF_SafestartManager.GetInstance().GetSafestartStatus();"\
 "		"\
 "		if (safeStart && stage == 0)"\
 "			stage = 1;"\
 "		"\
 "		if (stage == 1 && !safeStart)"\
 "		{"\
 "			stage = 2;"\
 "			deleteFlags();"\
 "		}"\
 "	}"
 m_bLockSlotsAfterSafestart 0
 m_aMissionDescriptors {
  CRF_MissionDescriptor "{644250503DF684C0}" {
   m_sTextData "Russian Spetznaz are en route to dispatch a HVT that intel indicates is enjoying their day at the Horse Track or Ruha Lava. Swedish Forces training in the area have been called up as QRF. Additionally the Spetznaz have been tasked with destroying NATO vehicles being transported by train, currently stopped in the area."\
   ""\
   "Spetznaz need to eliminate the HVT & just the Stryker MGS x2 "\
   "OR the entire mechanized shipment  (the Stykers, The UH-60 DAP  and Command Trucks)"\
   ""\
   "BLUFOR Composition: Infantry Company"\
   "BLUFOR Assets: UH60, AH6M_AIM92"\
   ""\
   "OPFOR Composition: Motorized Infantry Company"\
   "OPFOR Assets: Armored Typhoon x3, GAZ's With PKP x3"\
   ""\
   "Time:"\
   ""\
   "Weather:"
  }
  CRF_MissionDescriptor "{64425051F2E00216}" {
   m_sTextData "NATO Command has called up Swedish forces on training to rescue a HVT in the area AND protect a train with various vehicle assets on it. "\
   ""\
   "HVT is either at the Horse Track or Ruha Lava."\
   ""\
   "The Train has 2 Stryker MGSs, A UH-60 DAP, 2 Command Trucks that need protection. "
  }
  CRF_MissionDescriptor "{64425051B9B5AF67}" {
   m_sTextData "Eliminate the HVT and Destroy the NATO vehicle assets on the train."\
   ""\
   "High command will only call it a success if the HVT is eliminated AND the 2 Stryker MGSs OR the entire set of vehicle assets on the train: Stryker MGS x2, UH-60 DAP x1, Command Truck x2"
  }
  CRF_MissionDescriptor "{644250519BE30999}" {
   m_sTitle "CIV Objectives"
   m_sTextData "Survive. "\
   ""\
   "Choose either area before safe start ends and remain within the border untill contacted by either faction (engine noise counts)."
   m_aFactionKeys {
    "CIV"
   }
  }
  CRF_MissionDescriptor "{6442505149CF6C93}" {
   m_sTextData "Opfor win cons are"\
   "A.) Eliminate the HVT and Destroy the Strykers MGS x2"\
   "B.) Destroy the Stryker MGS x2, UH-60 DAP x1, Command Truck x2"\
   ""\
   "Blufor victory if HVT and assets survive till end of mission. "\
   ""\
   "Civilian/HVT is tasked with staying alive but may not move from the marked border UNTIL contacted by either faction (engine noise counts)"
  }
 }
 m_sFactionOneKey "BLU"
 m_sFactionTwoKey "OPF"
 m_BLUFORGearScriptSettings CRF_GearScriptContainer "{64570ACB9B419A7B}" {
  m_rGearScript "{3B6E53A2C1C47AA1}Configs/Gearscripts/Custom/Owen7/CRF_GS_NATO_SWED.conf"
 }
 m_OPFORGearScriptSettings CRF_GearScriptContainer "{64570ACB9B11EAAD}" {
  m_rGearScript "{A8E8ED3C501DDCFE}Configs/Gearscripts/Custom/Owen7/CRF_GS_RU_MODERN.conf"
 }
